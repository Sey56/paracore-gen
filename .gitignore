# Python
__pycache__/
*.pyc
*.pyo
.venv/
.python-version

# IDE
.vs/
.vscode/
.idea/
.claude/
# Agent state (session memory + skills) — local only. Same rule as paracore-pro.
.workbuddy-ai/

# OS
.DS_Store

# Build
dist/
build/
*.spec
*.exe
*.log
version-info.txt
graphify-out/
# Transient REPL process capture — regenerated on demand, never source.
.repl_proc.txt

# ── Build output & generated files — NEVER tracked (ecosystem rule, 2026-10-08) ──
# Only SOURCE is tracked. Everything below is generated by a build, a test run or an
# agent session, and regenerates on demand. Tracking these is what grows a repo
# without bound: paracore/.git reached 493 MB on historical installers alone
# (measured 2026-10-08 — the files were long gone from HEAD, the blobs were not).
[Bb]in/
[Oo]bj/
dist/
build/
installers/
installer_staging/
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
target/
.kilo/
.workbuddy-ai/
*.log
# Dev-run artefacts: a non-frozen server writes its log AND its metrics into the repo
# root, so running a probe (or the server from source) dirtied the tree with a metrics
# file that no build ever reads. `*.log` already covered the log half.
paracore_*_metrics.json

# spikes/ holds the MCP's PROOF INSTRUMENTS, not scratch. build-gen.ps1 step 4b
# runs verify_bundled_prompts.py, and the paracore-gen-build-verify skill names
# extract_skill.py and probe_installed_compliance.py. Those .py files are source.
# Everything else here is probe output: logs, dumps, extracted text, and the
# DoorScratch.rfa build artefact (which the family-artifacts skill cites only as
# an example of what robocopy /E ships from an untracked path).
spikes/*
!spikes/*.py

# Runtime state written by the MCP server while Revit is attached
.mcp_proc.txt
.revit_state.txt
